<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.vaccinetracker.controllers.InventoryController"
      stylesheets="@../styles/theme.css, @../styles/admin.css"
      spacing="20" styleClass="content-area">

    <Label text="Vaccine Inventory Management" styleClass="page-title" />

    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <!-- Left: Inventory List -->
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <Label text="Current Stock Levels" styleClass="section-header"/>
            <TableView fx:id="inventoryTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="siteColumn" text="Vaccination Site" prefWidth="200"/>
                    <TableColumn fx:id="vaccineColumn" text="Vaccine" prefWidth="150"/>
                    <TableColumn fx:id="stockColumn" text="Stock Quantity" prefWidth="100"/>
                    <TableColumn fx:id="expiryDateColumn" text="Expiry Date" prefWidth="120"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
            <HBox alignment="CENTER_RIGHT">
                <Button text="Remove Vaccine" onAction="#handleRemoveVaccine" styleClass="button-secondary"/>
            </HBox>
        </VBox>

        <!-- Right: Add Stock Form -->
        <VBox spacing="20" maxWidth="350" style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
            <Label text="Add Vaccine Stock" styleClass="section-header"/>
            
            <VBox spacing="5">
                <Label text="Select Site" styleClass="form-label"/>
                <ComboBox fx:id="siteComboBox" promptText="Choose Hospital/Clinic" maxWidth="Infinity"/>
            </VBox>
            
            <VBox spacing="5">
                <Label text="Select Vaccine" styleClass="form-label"/>
                <ComboBox fx:id="vaccineComboBox" promptText="Choose Vaccine" maxWidth="Infinity"/>
            </VBox>
            
            <VBox spacing="5">
                <Label text="Quantity to Add" styleClass="form-label"/>
                <TextField fx:id="quantityField" promptText="Enter amount" styleClass="text-field"/>
            </VBox>
            
            <VBox spacing="5">
                <Label text="Expiry Date" styleClass="form-label"/>
                <DatePicker fx:id="expiryDatePicker" promptText="Select expiry date" maxWidth="Infinity"/>
            </VBox>
            
            <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 20 0 0 0;">
                <Button text="Add Vaccine" onAction="#handleAddVaccine" styleClass="button-primary"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>
