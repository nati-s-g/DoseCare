<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.vaccinetracker.controllers.RegisterChildController">
   <top>
      <HBox style="-fx-background-color: #2196F3; -fx-padding: 15px;" spacing="20">
         <Label text="Register New Child" styleClass="label-title" style="-fx-text-fill: white;" />
         <HBox HBox.hgrow="ALWAYS" />
         <Button text="Back to Dashboard" fx:id="backButton" styleClass="button-secondary" onAction="#handleBack" />
      </HBox>
   </top>
   
   <center>
      <VBox spacing="20" style="-fx-padding: 30px; -fx-background-color: #f5f5f5;" alignment="CENTER">
         
         <VBox styleClass="card" spacing="20" prefWidth="600" alignment="CENTER">
            <Label text="Child Information" styleClass="label-header" />
            
            <GridPane hgap="15" vgap="15" alignment="CENTER">
               <columnConstraints>
                  <ColumnConstraints prefWidth="150" />
                  <ColumnConstraints prefWidth="300" />
               </columnConstraints>
               
               <!-- Child Name -->
               <Label text="Child Name *:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
               <TextField fx:id="childNameField" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="0" />
               
               <!-- Date of Birth -->
               <Label text="Date of Birth *:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
               <DatePicker fx:id="dateOfBirthPicker" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="1" />
               
               <!-- Father Name -->
               <Label text="Father's Name (Guardian 1) *:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
               <TextField fx:id="fatherNameField" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="2" />
               
               <!-- Father Contact -->
               <Label text="Father's Contact *:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
               <TextField fx:id="fatherContactField" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="3" />
               
               <!-- Mother Name -->
               <Label text="Mother's Name (Guardian 2) *:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
               <TextField fx:id="motherNameField" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="4" />
               
               <!-- Mother Contact -->
               <Label text="Mother's Contact *:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
               <TextField fx:id="motherContactField" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="5" />
               
               <!-- Hospital ID -->
               <Label text="Hospital ID:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
               <TextField fx:id="hospitalIdField" prefWidth="300" text="HOSP001" GridPane.columnIndex="1" GridPane.rowIndex="6" />
            </GridPane>
            
            <!-- Status Label -->
            <Label fx:id="statusLabel" text="" visible="false" wrapText="true" prefWidth="550" />
            
            <!-- Buttons -->
            <HBox spacing="15" alignment="CENTER">
               <Button text="Register Child" fx:id="registerButton" styleClass="button-primary" onAction="#handleRegister" prefWidth="150" />
               <Button text="Clear" fx:id="clearButton" styleClass="button-secondary" onAction="#handleClear" prefWidth="150" />
            </HBox>
            
            <Label text="* Required fields" styleClass="label-info" />
         </VBox>
         
      </VBox>
   </center>
</BorderPane>

