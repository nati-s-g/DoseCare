<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.vaccinetracker.controllers.HealthAlertsController">
    <Label text="Health Alerts Management" styleClass="page-title"/>
    
    <TabPane VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">
        <tabs>
            <Tab text="New Alert">
                <content>
                    <VBox spacing="15" style="-fx-padding: 20;">
                        <Label text="Compose New Health Alert" styleClass="section-header"/>
                        
                        <VBox spacing="5">
                            <Label text="Subject / Heading"/>
                            <TextField fx:id="subjectField" promptText="Enter alert title..."/>
                        </VBox>
                        
                        <VBox spacing="5">
                            <Label text="Severity Level"/>
                            <ComboBox fx:id="severityCombo" promptText="Select Severity"/>
                        </VBox>
                        
                        <VBox spacing="5" VBox.vgrow="ALWAYS">
                            <Label text="Message Body"/>
                            <TextArea fx:id="messageArea" promptText="Enter detailed message..." wrapText="true" VBox.vgrow="ALWAYS"/>
                        </VBox>
                        
                        <HBox alignment="CENTER_RIGHT" spacing="10">
                            <Button text="Clear" onAction="#handleClear" styleClass="button-secondary"/>
                            <Button text="Send Alert" onAction="#handleSendAlert" styleClass="button-primary"/>
                        </HBox>
                    </VBox>
                </content>
            </Tab>
            
            <Tab text="Previous Alerts">
                <content>
                    <VBox spacing="15" style="-fx-padding: 20;">
                        <TableView fx:id="alertsTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="dateCol" text="Date" prefWidth="100"/>
                                <TableColumn fx:id="severityCol" text="Severity" prefWidth="100"/>
                                <TableColumn fx:id="titleCol" text="Subject" prefWidth="200"/>
                                <TableColumn fx:id="messageCol" text="Message" prefWidth="400"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                        
                        <HBox alignment="CENTER_RIGHT" spacing="10">
                            <Button text="View Full Message" onAction="#handleViewDetails" styleClass="button-secondary"/>
                        </HBox>
                    </VBox>
                </content>
            </Tab>
        </tabs>
    </TabPane>
</VBox>