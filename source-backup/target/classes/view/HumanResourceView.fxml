<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.vaccinetracker.controllers.HumanResourceController"
      stylesheets="@../styles/theme.css, @../styles/admin.css"
      spacing="20" styleClass="content-area">

    <Label text="Human Resources Management" styleClass="page-title" />

    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <tabs>
            <!-- Nurses Tab -->
            <Tab text="Nurses">
                <content>
                    <VBox spacing="15" style="-fx-padding: 20;">
                        <TableView fx:id="nurseTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="nurseNameCol" text="Name" prefWidth="150"/>
                                <TableColumn fx:id="nurseIdCol" text="Vaccinator ID" prefWidth="120"/>
                                <TableColumn fx:id="nurseContactCol" text="Contact Info" prefWidth="150"/>
                                <TableColumn fx:id="nurseSiteCol" text="Vaccination Site" prefWidth="200"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                        
                        <HBox alignment="CENTER_RIGHT">
                             <Button text="Remove Selected" onAction="#handleRemoveNurse" styleClass="button-secondary"/>
                        </HBox>

                        <Label text="Add New Nurse" styleClass="section-header"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <TextField fx:id="nurseNameField" promptText="Full Name" HBox.hgrow="ALWAYS"/>
                            <TextField fx:id="nurseContactField" promptText="Contact Info" prefWidth="150"/>
                            <ComboBox fx:id="nurseSiteCombo" promptText="Select Site" prefWidth="200"/>
                            <Button text="Add Nurse" onAction="#handleAddNurse" styleClass="button-primary"/>
                        </HBox>
                    </VBox>
                </content>
            </Tab>

            <!-- Doctors Tab -->
            <Tab text="Doctors">
                <content>
                    <VBox spacing="15" style="-fx-padding: 20;">
                        <TableView fx:id="doctorTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="doctorNameCol" text="Name" prefWidth="150"/>
                                <TableColumn fx:id="doctorIdCol" text="Doctor ID" prefWidth="120"/>
                                <TableColumn fx:id="doctorContactCol" text="Contact Info" prefWidth="150"/>
                                <TableColumn fx:id="doctorSiteCol" text="Vaccination Site" prefWidth="200"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                        
                        <HBox alignment="CENTER_RIGHT">
                             <Button text="Remove Selected" onAction="#handleRemoveDoctor" styleClass="button-secondary"/>
                        </HBox>

                        <Label text="Add New Doctor" styleClass="section-header"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <TextField fx:id="doctorNameField" promptText="Full Name" HBox.hgrow="ALWAYS"/>
                            <TextField fx:id="doctorContactField" promptText="Contact Info" prefWidth="150"/>
                            <ComboBox fx:id="doctorSiteCombo" promptText="Select Site" prefWidth="200"/>
                            <Button text="Add Doctor" onAction="#handleAddDoctor" styleClass="button-primary"/>
                        </HBox>
                    </VBox>
                </content>
            </Tab>

            <!-- Other Staff Tab -->
            <Tab text="Other Staff">
                <content>
                    <VBox spacing="15" style="-fx-padding: 20;">
                        <TableView fx:id="staffTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="staffNameCol" text="Name" prefWidth="150"/>
                                <TableColumn fx:id="staffIdCol" text="Staff ID" prefWidth="120"/>
                                <TableColumn fx:id="staffRoleCol" text="Role" prefWidth="150"/>
                                <TableColumn fx:id="staffContactCol" text="Contact Info" prefWidth="150"/>
                                <TableColumn fx:id="staffSiteCol" text="Vaccination Site" prefWidth="200"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                        
                        <HBox alignment="CENTER_RIGHT">
                             <Button text="Remove Selected" onAction="#handleRemoveStaff" styleClass="button-secondary"/>
                        </HBox>

                        <Label text="Add New Staff" styleClass="section-header"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <TextField fx:id="staffNameField" promptText="Full Name" HBox.hgrow="ALWAYS"/>
                            <ComboBox fx:id="staffRoleCombo" promptText="Select Role" prefWidth="150"/>
                            <TextField fx:id="staffContactField" promptText="Contact Info" prefWidth="150"/>
                            <ComboBox fx:id="staffSiteCombo" promptText="Select Site" prefWidth="200"/>
                            <Button text="Add Staff" onAction="#handleAddStaff" styleClass="button-primary"/>
                        </HBox>
                    </VBox>
                </content>
            </Tab>
        </tabs>
    </TabPane>
</VBox>
