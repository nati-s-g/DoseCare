flowchart TD
    %% ==========================================
    %% STYLING: Large Fonts & Clear Boxes
    %% ==========================================
    classDef adminFill fill:#bbdefb,stroke:#0d47a1,stroke-width:4px,fontsize:24px,rx:10
    classDef vaccFill fill:#ffcc80,stroke:#e65100,stroke-width:4px,fontsize:24px,rx:10
    classDef parentFill fill:#e1bee7,stroke:#4a148c,stroke-width:4px,fontsize:24px,rx:10
    
    classDef moduleFill fill:#ffffff,stroke:#455a64,stroke-width:2px,fontsize:18px,rx:5
    classDef dataFill fill:#cfd8dc,stroke:#37474f,stroke-width:2px,fontsize:18px,shape:rect

    %% ==========================================
    %% SUBGRAPH STYLING (Rounded Corners)
    %% ==========================================
    style AdminZone fill:#e3f2fd,stroke:#0d47a1,stroke-width:2px,rx:20,ry:20
    style VaccZone fill:#fff3e0,stroke:#e65100,stroke-width:2px,rx:20,ry:20
    style ParentZone fill:#f3e5f5,stroke:#4a148c,stroke-width:2px,rx:20,ry:20

    %% ==========================================
    %% 1. ADMIN ZONE
    %% ==========================================
    subgraph AdminZone [ADMINISTRATION]
        direction TB
        Admin(ADMIN):::adminFill
        
        %% Modules
        A_Dash(Dashboard):::moduleFill
        A_Child(Children Mgmt):::moduleFill
        A_Inv(Inventory & Sites):::moduleFill
        A_HR(HR & Staff):::moduleFill
        A_Alert(Health Alerts):::moduleFill

        %% Connections
        Admin --> A_Dash
        Admin --> A_Child
        Admin --> A_Inv
        Admin --> A_HR
        Admin --> A_Alert
    end

    %% ==========================================
    %% 2. VACCINATOR ZONE
    %% ==========================================
    subgraph VaccZone [CLINIC]
        direction TB
        Vacc(VACCINATOR):::vaccFill
        
        %% Modules
        V_Dash(Dashboard):::moduleFill
        V_Rec(Records & Register):::moduleFill

        %% Connections
        Vacc --> V_Dash
        Vacc --> V_Rec
    end

    %% ==========================================
    %% 3. PARENT ZONE
    %% ==========================================
    subgraph ParentZone [FAMILY]
        direction TB
        Par(PARENT):::parentFill
        
        %% Modules
        P_Dash(Main Dashboard):::moduleFill
        P_Kids(My Children):::moduleFill
        P_Sched(Schedule & Records):::moduleFill

        %% Connections
        Par --> P_Dash
        Par --> P_Kids
        Par --> P_Sched
    end

    %% ==========================================
    %% 4. DATA LAYER (Centralized)
    %% ==========================================
    D_Child[Child Profile]:::dataFill
    D_Stock[Vaccine Stock]:::dataFill
    D_Staff[Staff Records]:::dataFill
    D_Recs[Health Records]:::dataFill

    %% ==========================================
    %% 5. SIMPLIFIED FLOWS
    %% ==========================================
    
    %% Admin Flows
    A_Child -->|Registers| D_Child
    A_Inv -->|Controls| D_Stock
    A_HR -->|Manages| D_Staff

    %% Vaccinator Flows
    V_Rec -->|Updates| D_Recs
    V_Rec -.->|Access| D_Child

    %% Parent Flows
    P_Kids -->|Views| D_Child
    P_Sched -->|Checks| D_Recs

    %% Alerts (Direct)
    A_Alert -.->|Broadcasts| P_Dash
