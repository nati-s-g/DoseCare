classDiagram
    direction TB
    
    %% By removing namespaces, the layout engine can pack items tighter together
    
    class User
    class Admin
    class Parent
    class Vaccinator
    class StaffMember

    class Child
    class VaccinationRecord
    class Vaccine
    class HealthAlert

    class VaccinationSite
    class InventoryItem

    %% Relationships
    User <|-- Admin
    User <|-- Parent
    User <|-- Vaccinator
    
    Parent "1" *-- "n" Child : registers
    Child "1" *-- "n" VaccinationRecord : has
    VaccinationRecord "n" --> "1" Vaccine : type
    Vaccinator "n" --> "1" VaccinationSite : at
    StaffMember "n" --> "1" VaccinationSite : at
    InventoryItem "n" --> "1" VaccinationSite : at
    InventoryItem "n" --> "1" Vaccine : stocks
    HealthAlert "n" --> "1" Child : targets

    %% Services Layer
    class AuthService
    class UserService
    class ChildService
    class VaccinationService
    class VaccineService
    class VaccinationSiteService
    class HumanResourceService
    class AlertService
    class StorageService

    %% Service Relationships - Connecting Entities to Services
    AuthService ..> User : authenticates
    UserService ..> User : manages accounts
    ChildService ..> Child : handles registration
    VaccinationService ..> VaccinationRecord : creates & tracks
    VaccineService ..> Vaccine : catalogs
    VaccinationSiteService ..> VaccinationSite : maintains
    VaccinationSiteService ..> InventoryItem : updates stock
    HumanResourceService ..> StaffMember : recruits & manages
    AlertService ..> HealthAlert : broadcasts
    StorageService ..> User : persists data

    %% Actor Interactions ("Works")
    Parent ..> ChildService : registers children
    Parent ..> VaccinationService : views history
    
    Admin ..> HumanResourceService : manages staff
    Admin ..> VaccinationSiteService : manages sites & inventory
    Admin ..> VaccineService : manages vaccine types
    Admin ..> AlertService : sends health alerts
    
    Vaccinator ..> VaccinationService : records administration
    Vaccinator ..> VaccinationSiteService : checks inventory

    User ..> AuthService : logs in
