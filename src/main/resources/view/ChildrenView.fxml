<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.vaccinetracker.controllers.ChildrenController"
      stylesheets="@../styles/theme.css, @../styles/admin.css"
      spacing="20" styleClass="content-area">

    <Label text="Children Management" styleClass="page-title" />

    <TabPane fx:id="childrenTabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <tabs>
            <Tab text="Registered Children" fx:id="registeredChildrenTab">
                <content>
                    <VBox spacing="10" style="-fx-padding: 20;">
                        <TableView fx:id="childrenTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="childIdColumn" text="Child ID" prefWidth="100"/>
                                <TableColumn fx:id="nameColumn" text="Name" prefWidth="150"/>
                                <TableColumn fx:id="dobColumn" text="Date of Birth" prefWidth="120"/>
                                <TableColumn fx:id="ageColumn" text="Age" prefWidth="100"/>
                                <TableColumn fx:id="genderColumn" text="Gender" prefWidth="100"/>
                                <TableColumn fx:id="guardianColumn" text="Guardian" prefWidth="150"/>
                                <TableColumn fx:id="contactColumn" text="Contact" prefWidth="150"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </VBox>
                </content>
            </Tab>
            <Tab text="Register New Child" fx:id="registerChildTab">
                <content>
                    <VBox spacing="20" style="-fx-padding: 30;" maxWidth="600">
                        <Label text="Register New Child" styleClass="section-header"/>
                        
                        <VBox spacing="5">
                            <Label text="Child Name" styleClass="form-label"/>
                            <TextField fx:id="nameField" promptText="Enter child's full name" styleClass="text-field"/>
                        </VBox>
                        
                        <VBox spacing="5">
                            <Label text="Date of Birth" styleClass="form-label"/>
                            <DatePicker fx:id="dobPicker" promptText="Select date of birth" maxWidth="Infinity"/>
                        </VBox>
                        
                        <VBox spacing="5">
                            <Label text="Gender" styleClass="form-label"/>
                            <ComboBox fx:id="genderComboBox" promptText="Select gender" maxWidth="Infinity"/>
                        </VBox>
                        
                        <VBox spacing="5">
                            <Label text="Guardian Name" styleClass="form-label"/>
                            <TextField fx:id="guardianField" promptText="Enter guardian's full name" styleClass="text-field"/>
                        </VBox>

                        <VBox spacing="5">
                            <Label text="Guardian Contact" styleClass="form-label"/>
                            <TextField fx:id="contactField" promptText="Enter guardian's contact number" styleClass="text-field"/>
                        </VBox>
                        
                        <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 20 0 0 0;">
                            <Button text="Clear" onAction="#handleClear" styleClass="button-secondary"/>
                            <Button text="Save" onAction="#handleSave" styleClass="button-primary"/>
                        </HBox>
                    </VBox>
                </content>
            </Tab>
            <Tab text="Notify Guardian/Parent" fx:id="notifyTab">
                <content>
                    <HBox spacing="20" style="-fx-padding: 20;">
                        <!-- Left: Child Selection -->
                        <VBox spacing="10" HBox.hgrow="ALWAYS" maxWidth="400">
                            <Label text="Select Children to Notify" styleClass="section-header"/>
                            <Button text="Select All" onAction="#handleSelectAll" styleClass="button-secondary"/>
                            <TableView fx:id="notifyTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="selectColumn" text="Select" prefWidth="50"/>
                                    <TableColumn fx:id="notifyNameColumn" text="Child Name" prefWidth="150"/>
                                    <TableColumn fx:id="notifyIdColumn" text="Child ID" prefWidth="100"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                            </TableView>
                        </VBox>
                        
                        <!-- Right: Notification Form -->
                        <VBox spacing="20" HBox.hgrow="ALWAYS" style="-fx-padding: 10;">
                            <Label text="Compose Notification" styleClass="section-header"/>
                            
                            <VBox spacing="5">
                                <Label text="Vaccine Name" styleClass="form-label"/>
                                <TextField fx:id="vaccineNameField" promptText="Enter vaccine name (e.g. Polio Vaccine)" styleClass="text-field"/>
                            </VBox>
                            
                            <VBox spacing="5">
                                <Label text="Explanation / Message" styleClass="form-label"/>
                                <TextArea fx:id="explanationArea" promptText="Enter detailed message for parents..." prefRowCount="10" wrapText="true" styleClass="text-area"/>
                            </VBox>
                            
                            <HBox alignment="CENTER_RIGHT">
                                <Button text="Notify Parents" onAction="#handleNotify" styleClass="button-primary"/>
                            </HBox>
                        </VBox>
                    </HBox>
                </content>
            </Tab>
        </tabs>
    </TabPane>
</VBox>
