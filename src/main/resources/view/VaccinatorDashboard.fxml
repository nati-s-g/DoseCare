<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.control.Separator?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.vaccinetracker.controllers.VaccinatorController"
            stylesheets="@../styles/theme.css, @../styles/admin.css">
   
   <!-- Left Sidebar -->
   <left>
      <VBox styleClass="sidebar">
         <!-- Logo -->
         <HBox alignment="CENTER" spacing="0">
            <Label text="Dose" styleClass="brand-green" />
            <Label text="Care" styleClass="brand-blue" />
         </HBox>
         
         <!-- Profile Section -->
         <VBox styleClass="profile-section">
            <StackPane>
               <Circle radius="35" fill="TRANSPARENT" stroke="WHITE" strokeWidth="2" />
               <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" fill="WHITE" scaleX="2.5" scaleY="2.5" />
            </StackPane>
            <Label fx:id="vaccinatorNameLabel" text="Vaccinator" styleClass="profile-name" />
         </VBox>
         
         <!-- Menu Items -->
         <VBox styleClass="menu-container">
            <Button text="Dashboard" styleClass="menu-button, active" fx:id="dashboardMenuButton" onAction="#handleDashboardMenu"/>
            <Button text="Vaccination Records" styleClass="menu-button" fx:id="recordsMenuButton" onAction="#handleRecordsMenu"/>
            <Button text="My Profile" styleClass="menu-button" fx:id="profileMenuButton" onAction="#handleProfileMenu"/>
         </VBox>
      </VBox>
   </left>
   
   <!-- Center Content -->
   <center>
      <VBox fx:id="contentArea" styleClass="content-area">
         <!-- Top Bar -->
         <VBox spacing="15">
             <HBox styleClass="top-bar">
                <Label text="Vaccinator Dashboard" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Logout" fx:id="logoutButton" styleClass="top-button" onAction="#handleLogout" />
             </HBox>
             <Separator styleClass="header-separator" />
         </VBox>
         
         <!-- Dashboard Content -->
         <VBox fx:id="mainContent" spacing="20" VBox.vgrow="ALWAYS">
            
            <!-- Stats Cards -->
            <HBox spacing="20" alignment="CENTER_LEFT">
               <VBox styleClass="stat-card, card-blue" HBox.hgrow="ALWAYS">
                  <Label fx:id="totalVaccinatedLabel" text="0" styleClass="stat-count" />
                  <Label text="Total Vaccinated" styleClass="stat-label" />
               </VBox>
               <VBox styleClass="stat-card, card-green" HBox.hgrow="ALWAYS">
                  <Label fx:id="siteLabel" text="Site" styleClass="stat-count" style="-fx-font-size: 24px;" />
                  <Label text="Assigned Site" styleClass="stat-label" />
               </VBox>
            </HBox>

            <!-- Pending Vaccinations Table -->
            <VBox styleClass="card" VBox.vgrow="ALWAYS">
                <Label text="Pending Vaccinations" styleClass="card-title"/>
                <TableView fx:id="pendingTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="childNameCol" text="Child Name" prefWidth="200"/>
                        <TableColumn fx:id="vaccineCol" text="Vaccine" prefWidth="200"/>
                        <TableColumn fx:id="dateCol" text="Due Date" prefWidth="150"/>
                        <TableColumn fx:id="statusCol" text="Status" prefWidth="150"/>
                        <TableColumn fx:id="actionCol" text="Action" prefWidth="150"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>
         </VBox>
      </VBox>
   </center>
</BorderPane>
