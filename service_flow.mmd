---
config:
  layout: elk
---
flowchart LR
 subgraph LogicZone["LOGIC & ORCHESTRATION"]
    direction TB
        VaccSvc("VaccinationService")
        AuthSvc("AuthService")
        HRSvc("HumanResourceService")
  end
 subgraph EntityZone["CORE ENTITY MANAGEMENT"]
    direction TB
        ChildSvc("ChildService")
        VaccineSvc("VaccineService")
        UserSvc("UserService")
        SiteSvc("VaccinationSiteService")
        AlertSvc("AlertService")
  end
 subgraph DataZone["PERSISTENCE LAYER"]
        Storage("StorageService")
  end
    
    %% Logic to Entity Flow
    AuthSvc -- Authenticates against --> UserSvc
    VaccSvc -- Manages Record for --> ChildSvc
    VaccSvc -- Uses Details from --> VaccineSvc
    HRSvc -- Assigns Staff to --> SiteSvc
    
    %% Data Persistence Flow
    Storage <== Persists Users ==> UserSvc
    Storage <== Persists Children ==> ChildSvc
    Storage <== Persists Vaccines ==> VaccineSvc
    Storage <== Persists Sites/Stock ==> SiteSvc
    Storage <== Persists Alerts ==> AlertSvc
    Storage <== Persists Records ==> VaccSvc
    Storage <== Persists Staff ==> HRSvc

    %% Styling
     AuthSvc:::logicFill
     VaccSvc:::logicFill
     HRSvc:::logicFill
     UserSvc:::entityFill
     ChildSvc:::entityFill
     VaccineSvc:::entityFill
     SiteSvc:::entityFill
     AlertSvc:::entityFill
     Storage:::infraFill
     
    classDef logicFill fill:#bbdefb,stroke:#0d47a1,stroke-width:2px,fontsize:24px,rx:10
    classDef entityFill fill:#ffffff,stroke:#455a64,stroke-width:2px,fontsize:24px,rx:5
    classDef infraFill fill:#cfd8dc,stroke:#37474f,stroke-width:2px,fontsize:24px,shape:rect
    style LogicZone fill:#e3f2fd,stroke:#0d47a1,stroke-width:2px,rx:20,ry:20
    style EntityZone fill:#f5f5f5,stroke:#616161,stroke-width:2px,rx:20,ry:20
    style DataZone fill:#eceff1,stroke:#37474f,stroke-width:2px,rx:20,ry:20
